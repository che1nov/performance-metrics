{
  "uid": "performance-red",
  "title": "Performance Lab — Platform vs Virtual Threads",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "Europe/Samara",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "performance",
    "RED",
    "homework"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Rate — completed HTTP requests / second",
      "datasource": {
        "type": "prometheus",
        "uid": "performance-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{uri=~\"/work/(platform|virtual)\"}[20s]))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors — HTTP 5xx / second (controlled fault phase)",
      "datasource": {
        "type": "prometheus",
        "uid": "performance-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{uri=~\"/work/(platform|virtual)\",status=~\"5..\"}[20s])) or on (uri) (0 * (sum by (uri) (rate(http_server_requests_seconds_count{uri=~\"/work/(platform|virtual)\"}[20s]))))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Duration — mean and p95, including queue wait",
      "datasource": {
        "type": "prometheus",
        "uid": "performance-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_sum{uri=~\"/work/(platform|virtual)\"}[20s])) / sum by (uri) (rate(http_server_requests_seconds_count{uri=~\"/work/(platform|virtual)\"}[20s]))",
          "legendFormat": "mean {{uri}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri=~\"/work/(platform|virtual)\"}[20s])))",
          "legendFormat": "p95 {{uri}}"
        }
      ]
    }
  ]
}
